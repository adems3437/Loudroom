{
  "name": "@loudroom/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput --exec \"node --env-file-if-exists=../../.env\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/admin-create.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@swc/core": "1.16.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "unplugin-swc": "2.0.0"
  },
  "dependencies": {
    "@loudroom/game-bluff": "workspace:*",
    "@loudroom/game-closest-number": "workspace:*",
    "@loudroom/game-drawing": "workspace:*",
    "@loudroom/game-image-location": "workspace:*",
    "@loudroom/game-quiz": "workspace:*",
    "@loudroom/game-sdk": "workspace:*",
    "@loudroom/game-sorting": "workspace:*",
    "@loudroom/game-who-would": "workspace:*",
    "@loudroom/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/websockets": "12.1.2",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  }
}
