{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "concurrency": "30",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL_TEST", "REDIS_URL_TEST"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "PUBLIC_URL",
        "CORS_ORIGINS",
        "SERVER_HOST",
        "SERVER_PORT",
        "WEB_PORT",
        "SOCKET_PORT",
        "PLAYER_RECONNECT_GRACE_MS",
        "IP_HASH_SECRET",
        "TRUST_PROXY",
        "PROFANITY_EXTRA_WORDS_FILE",
        "MEDIA_DIR",
        "MEDIA_MAX_UPLOAD_BYTES",
        "SESSION_RETENTION_DAYS",
        "REST_RATE_LIMIT_CAPACITY",
        "REST_RATE_LIMIT_PER_SECOND",
        "API_INTERNAL_URL",
        "MEDIA_MAX_VIDEO_BYTES",
        "FFMPEG_PATH",
        "FFPROBE_PATH"
      ]
    }
  }
}
