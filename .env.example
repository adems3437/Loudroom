# Copy to .env:  cp .env.example .env
# Values here work as-is for local development.

# ── Docker Compose ───────────────────────────────────────────────────────────
# Makes a plain `docker compose up` start the development stack.
COMPOSE_FILE=compose.yml:compose.dev.yml

# PostgreSQL container credentials and the host port it is published on (127.0.0.1 only).
POSTGRES_USER=loudroom
POSTGRES_PASSWORD=loudroom
POSTGRES_DB=loudroom
POSTGRES_PORT=5432

# Host port Redis is published on (127.0.0.1 only).
REDIS_PORT=6379

# ── Server (apps/server) ─────────────────────────────────────────────────────
# Connection strings used when the server runs on the host (`pnpm dev`).
# Inside Docker, compose.dev.yml points them at the postgres/redis services instead.
DATABASE_URL=postgresql://loudroom:loudroom@localhost:5432/loudroom
REDIS_URL=redis://localhost:6379/0

# Integration tests use a separate database and Redis DB index; they wipe it freely.
DATABASE_URL_TEST=postgresql://loudroom:loudroom@localhost:5432/loudroom_test
REDIS_URL_TEST=redis://localhost:6379/1

# Interface and port the server listens on. 0.0.0.0 lets phones on the LAN connect.
SERVER_HOST=0.0.0.0
SERVER_PORT=4000

# Address players open in their browser. QR codes and join links are built from it,
# and its origin is allowed by CORS. For phone testing on the LAN use your machine's
# LAN IP, e.g. http://192.168.1.20:3000.
PUBLIC_URL=http://localhost:3000

# Additional comma-separated browser origins allowed by CORS (e.g. http://localhost:3000
# when PUBLIC_URL is a LAN address). Leave empty if none.
CORS_ORIGINS=

# How long a disconnected player keeps their slot before it is freed (ms). SPEC §4: 90 s.
PLAYER_RECONNECT_GRACE_MS=90000

# Secret key for hashing client IPs in rate-limit keys (IPs are never stored in plain form).
# Use a long random value outside development:  openssl rand -base64 32
IP_HASH_SECRET=dev-only-ip-hash-secret-change-me

# Trust the X-Forwarded-For header. Only enable behind our own reverse proxy.
TRUST_PROXY=false

# Optional file with extra blocked nickname words, one per line ("=word" = whole word only).
PROFANITY_EXTRA_WORDS_FILE=

# Directory for uploaded media (images are re-encoded to WebP). Relative paths start at
# apps/server. Inside Docker it is a named volume.
MEDIA_DIR=data/media

# Largest accepted upload in bytes (default 10 MiB).
MEDIA_MAX_UPLOAD_BYTES=10485760

# Development admin account created by `pnpm db:seed` (only when both are set and the email
# has no account yet). Never set these in production: create the first admin with
# `pnpm admin:create --email you@example.com` instead.
ADMIN_SEED_EMAIL=admin@loudroom.local
ADMIN_SEED_PASSWORD=loudroom-admin

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# Host port of the Next.js app.
WEB_PORT=3000

# Port browsers use to reach the Socket.IO server on the same host name as the page.
# Leave empty when a reverse proxy serves the server on the page's own origin.
SOCKET_PORT=4000

# Where the web app forwards /api and /media (same-origin admin API and uploaded images).
# Inside Docker compose.dev.yml points it at the server service.
API_INTERNAL_URL=http://localhost:4000
