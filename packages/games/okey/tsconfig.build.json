{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.test-support.ts"],
  "references": [
    {
      "path": "../../game-sdk/tsconfig.build.json"
    },
    {
      "path": "../../table-kit/tsconfig.build.json"
    }
  ]
}
