# Production settings for scripts/prod.sh (compose.yml + compose.prod.yml). Copy to .env.prod
# and fill in every value marked "required". Generate secrets with:  openssl rand -hex 32
# See docs/DEPLOY.md.

# Docker Compose project; keeps production volumes apart from the development stack.
COMPOSE_PROJECT_NAME=loudroom-prod

# ── Address ──────────────────────────────────────────────────────────────────
# Required. The address players open (QR codes and join links are built from it). With
# https://, admin cookies get the Secure flag; use sites/tls.conf for HTTPS (docs/DEPLOY.md).
PUBLIC_URL=https://example.com
# Extra browser origins allowed by CORS, comma-separated. Usually empty.
CORS_ORIGINS=
# Ports Nginx publishes on this machine.
HTTP_PORT=80
HTTPS_PORT=443
# Directory with fullchain.pem and privkey.pem for HTTPS.
TLS_CERTS_DIR=./docker/nginx/certs

# Link to the source code shown on the home page (AGPL-3.0 §13). If you run a changed copy,
# point it at your own published source.
SOURCE_CODE_URL=https://github.com/adems3437/Loudroom

# ── Secrets ──────────────────────────────────────────────────────────────────
# Required. Use a URL-safe value (hex): it is part of the database URL.
POSTGRES_PASSWORD=
POSTGRES_USER=loudroom
POSTGRES_DB=loudroom
# Required, at least 32 characters: key for hashing client IPs in rate-limit keys.
IP_HASH_SECRET=

# ── Game and content ─────────────────────────────────────────────────────────
PLAYER_RECONNECT_GRACE_MS=90000
# Days game history is kept (SPEC §9 KVKK); 0 keeps it forever.
SESSION_RETENTION_DAYS=180
# Upload limits in bytes: images 10 MiB, videos 50 MiB.
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=52428800
PROFANITY_EXTRA_WORDS_FILE=

# ── Backups ──────────────────────────────────────────────────────────────────
# Nightly backup at this hour in TZ, kept for BACKUP_KEEP_DAYS days (backups volume).
TZ=Europe/Istanbul
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# ── Building behind a TLS-intercepting proxy ─────────────────────────────────
# Path to the proxy's CA certificate (PEM); leave empty otherwise.
EXTRA_CA_CERTS=

# Never set ADMIN_SEED_EMAIL / ADMIN_SEED_PASSWORD here: the server refuses to start with
# them. Create the first admin with:
#   scripts/prod.sh run --rm server node dist/cli/admin-create.js --email you@example.com
